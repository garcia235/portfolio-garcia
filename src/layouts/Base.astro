---
import '../styles/global.css';
import { person, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = 'media/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const path = Astro.url.pathname;
const isHome = path === url('') || path === url('').replace(/\/$/, '');
const nav = [
  { href: isHome ? '#projetos' : url('#projetos'), label: 'Projetos' },
  { href: isHome ? '#principios' : url('#principios'), label: 'Como trabalho' },
  { href: isHome ? '#trajetoria' : url('#trajetoria'), label: 'Trajetória' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0c0d0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // tema antes da pintura, para não piscar
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (_) {}
      document.documentElement.classList.add('js-reveal');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: person.fullName,
      jobTitle: person.role,
      email: `mailto:${person.email}`,
      telephone: person.phone,
      sameAs: [person.linkedin, person.github],
      worksFor: [
        { '@type': 'Organization', name: 'AI8' },
        { '@type': 'Organization', name: 'Polara Innovations', url: 'https://polarainnovations.com/' },
        { '@type': 'Organization', name: 'Taak' },
      ],
    })} />
  </head>

  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href={url('')} aria-label="Arthur Garcia, início">
          <span class="brand-mark" aria-hidden="true">AG</span>
          <span class="brand-name">Arthur Garcia</span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="topbar-actions">
          <button class="theme" type="button" aria-label="Alternar tema claro e escuro" data-theme-toggle>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M12 7a5 5 0 0 1 0 10z" fill="currentColor" />
            </svg>
          </button>
          <a class="btn primary small" href={person.whatsapp} target="_blank" rel="noopener">Contato</a>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="footer" id="contato">
      <div class="wrap footer-in">
        <div class="footer-cta" data-reveal>
          <span class="kicker">Contato</span>
          <h2>Tem um sistema que precisa conversar com outro?</h2>
          <p>
            Estou aberto a conversas sobre arquitetura, integrações e produtos SaaS. Me chama no
            WhatsApp ou por e-mail.
          </p>
          <div class="footer-actions">
            <a class="btn primary" href={person.whatsapp} target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.2Z"/></svg>
              Chamar no WhatsApp <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn" href={`mailto:${person.email}`}>{person.email}</a>
            <button class="btn" type="button" data-copy={person.email}>Copiar e-mail</button>
          </div>
        </div>
        <div class="footer-meta">
          <ul class="footer-links">
            <li><a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
            <li><a href={person.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
          </ul>
          <p class="mono">{person.location} · {new Date().getFullYear()}</p>
        </div>
      </div>
    </footer>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      // tema
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (_) {}
      });

      // copiar e-mail
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy ?? '');
            if (toast) {
              toast.textContent = 'E-mail copiado.';
              toast.classList.add('show');
              setTimeout(() => toast.classList.remove('show'), 1800);
            }
          } catch (_) {
            location.href = `mailto:${b.dataset.copy}`;
          }
        });
      });

      // entrada ao rolar
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .topbar-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; }
  .brand-mark {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center;
    border: 1px solid var(--line-2); color: var(--accent);
  }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    text-decoration: none; color: var(--ink-2); font-size: 15px;
    padding: 8px 12px; border-radius: 999px; transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); background: var(--bg-2); }
  .topbar-actions { display: flex; align-items: center; gap: 8px; }
  .theme {
    width: 38px; height: 38px; border-radius: 999px; border: 1px solid var(--line-2);
    background: transparent; color: var(--ink); display: grid; place-items: center; cursor: pointer;
  }
  .theme:hover { border-color: var(--ink); }
  .btn.small { padding: 8px 16px; font-size: 14px; }

  @media (max-width: 760px) {
    nav { display: none; }
    .brand-name { display: none; }
  }

  .footer { border-top: 1px solid var(--line); padding: clamp(72px, 10vw, 120px) 0 40px; background: var(--bg-2); }
  .footer-in { display: grid; gap: 56px; }
  .footer-cta { display: grid; gap: 18px; max-width: 760px; }
  .footer-cta h2 { font-size: clamp(32px, 5vw, 60px); }
  .footer-cta p { color: var(--ink-2); font-size: 18px; max-width: 560px; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .footer-actions .btn.primary { word-break: break-all; }
  .footer-meta {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;
    border-top: 1px solid var(--line); padding-top: 24px; color: var(--muted); font-size: 14px;
  }
  .footer-links { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; }
  .footer-links a { text-decoration: none; color: var(--ink-2); }
  .footer-links a:hover { color: var(--accent); }

  .toast {
    position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px);
    background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 999px;
    font-size: 14px; font-weight: 600; opacity: 0; pointer-events: none;
    transition: opacity .25s, transform .25s var(--ease); z-index: 80;
  }
  .toast:global(.show) { opacity: 1; transform: translate(-50%, 0); }
</style>
