---
import Base from './Base.astro';
import { featured, url } from '../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  period: string;
  team: string;
}

const { slug, title, description, period, team } = Astro.props;
const i = featured.findIndex((p) => p.slug === slug);
const p = featured[i];
const next = featured[(i + 1) % featured.length];
---

<Base title={title} description={description}>
  <article class="cs" style={`--c:${p.color}`}>
    <header class="cs-hero">
      <div class="wrap">
        <a class="back mono" href={url('#projetos')}>← Todos os projetos</a>
        <p class="kicker">{p.org}</p>
        <h1>{p.name}</h1>
        <p class="cs-one">{p.oneLiner}</p>

        <dl class="cs-meta">
          <div><dt>Meu papel</dt><dd>{p.role}</dd></div>
          <div><dt>Período</dt><dd>{period}</dd></div>
          <div><dt>Time</dt><dd>{team}</dd></div>
          <div><dt>Stack</dt><dd><ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul></dd></div>
        </dl>

        {p.live && (
          <a class="btn primary" href={p.live} target="_blank" rel="noopener">
            {p.liveLabel ? `Ver a ${p.liveLabel.toLowerCase()}` : 'Abrir o produto'} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </header>

    <div class="cs-media wrap">
      <slot name="media" />
    </div>

    <div class="wrap cs-body">
      <slot />
    </div>

    <nav class="cs-next" aria-label="Próximo projeto">
      <div class="wrap">
        <a href={url(`projetos/${next.slug}`)} style={`--n:${next.color}`}>
          <span class="mono">Próximo estudo de caso</span>
          <strong>{next.name} <span aria-hidden="true">→</span></strong>
        </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .cs-hero { padding: clamp(40px, 7vw, 88px) 0 clamp(32px, 5vw, 56px); position: relative; overflow: hidden; }
  .cs-hero::before {
    content: ''; position: absolute; right: -10%; top: -30%; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 16%, transparent), transparent);
    pointer-events: none;
  }
  .cs-hero .wrap { display: grid; gap: 20px; position: relative; }
  .back { font-size: 13px; color: var(--muted); text-decoration: none; width: fit-content; }
  .back:hover { color: var(--ink); }
  .cs-hero .kicker { color: var(--c); }
  h1 { font-size: clamp(52px, 9vw, 120px); letter-spacing: -0.05em; font-weight: 800; line-height: .95; }
  .cs-one { font-size: clamp(19px, 2.1vw, 24px); max-width: 820px; color: var(--ink); line-height: 1.45; }

  .cs-meta {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 12px 0 8px;
    padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .cs-meta dt { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 6px; }
  .cs-meta dd { margin: 0; font-size: 15px; color: var(--ink-2); }
  .cs-hero .btn { width: fit-content; }
  .cs-hero .btn.primary { background: var(--c); border-color: var(--c); color: #0c0d0f; }
  @media (max-width: 860px) { .cs-meta { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .cs-meta { grid-template-columns: 1fr; } }

  .cs-media { margin-bottom: clamp(48px, 7vw, 96px); }

  .cs-body { display: grid; gap: clamp(56px, 8vw, 104px); padding-bottom: clamp(72px, 10vw, 128px); }

  .cs-next { border-top: 1px solid var(--line); }
  .cs-next a { display: grid; gap: 6px; padding: clamp(40px, 6vw, 72px) 0; text-decoration: none; }
  .cs-next .mono { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; }
  .cs-next strong { font-size: clamp(36px, 6vw, 72px); letter-spacing: -0.04em; transition: color .25s; }
  .cs-next a:hover strong { color: var(--n); }

  /* ---- blocos usados pelas páginas de caso ---- */
  .cs-body :global(.block) { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); }
  .cs-body :global(.block > h2) {
    font-size: 14px; font-family: var(--font-mono); font-weight: 500; text-transform: uppercase; letter-spacing: .1em;
    color: var(--muted); position: sticky; top: 96px; align-self: start; padding-top: 6px;
  }
  .cs-body :global(.block > h2 span) { color: var(--c); margin-right: 8px; }
  .cs-body :global(.prose) { display: grid; gap: 18px; max-width: 720px; font-size: 18px; color: var(--ink-2); }
  .cs-body :global(.prose strong) { color: var(--ink); }
  .cs-body :global(.prose h3) { font-size: clamp(24px, 2.6vw, 32px); color: var(--ink); margin-top: 8px; }
  .cs-body :global(.prose ul) { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  .cs-body :global(.prose li::marker) { color: var(--c); }
  .cs-body :global(.prose code) { font-size: .88em; background: var(--bg-2); border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; }
  .cs-body :global(.lead) { font-size: clamp(22px, 2.6vw, 30px); color: var(--ink); line-height: 1.35; letter-spacing: -0.01em; }

  .cs-body :global(.decisions) { display: grid; gap: 14px; }
  .cs-body :global(.decision) { padding: 22px 24px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); display: grid; gap: 8px; }
  .cs-body :global(.decision h3) { font-size: 19px; margin: 0; color: var(--ink); }
  .cs-body :global(.decision p) { font-size: 16px; }
  .cs-body :global(.decision .why) { font-size: 14px; color: var(--muted); }
  .cs-body :global(.decision .why b) { color: var(--c); font-weight: 600; }

  .cs-body :global(.numbers) { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .cs-body :global(.numbers div) { padding: 20px; border-radius: 12px; background: var(--bg-2); border: 1px solid var(--line); }
  .cs-body :global(.numbers strong) { display: block; font-size: clamp(28px, 3.4vw, 40px); color: var(--c); letter-spacing: -0.03em; line-height: 1.1; }
  .cs-body :global(.numbers span) { font-size: 14px; color: var(--muted); }

  .cs-body :global(.gallery) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .cs-body :global(.gallery figure) { margin: 0; display: grid; gap: 8px; }
  .cs-body :global(.gallery img) { border-radius: 10px; border: 1px solid var(--line); aspect-ratio: 16/9; object-fit: cover; width: 100%; }
  .cs-body :global(.gallery figcaption) { font-size: 13px; color: var(--muted); }

  .cs-body :global(.player) { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #000; }
  .cs-body :global(.player video) { width: 100%; aspect-ratio: 16/9; }

  @media (max-width: 860px) {
    .cs-body :global(.block) { grid-template-columns: 1fr; }
    .cs-body :global(.block > h2) { position: static; }
    .cs-body :global(.gallery) { grid-template-columns: 1fr; }
  }
</style>
